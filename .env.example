# Kopiere diese Datei nach .env und trage sichere Werte ein
# cp .env.example .env

# PostgreSQL
DB_NAME=service_calculator
DB_USER=postgres
DB_PASSWORD=HIER_SICHERES_PASSWORD_EINTRAGEN

# Frontend → Backend Kommunikation
# Im Docker-Compose-Setup ist /api über nginx an das Backend weitergeleitet.
# Für lokale Entwicklung ohne Docker setze z. B. http://localhost:3000/api
# Authentication (optional — when set, API routes require a Bearer token)
# Generate a strong secret, e.g. with: openssl rand -hex 32
JWT_SECRET=

VITE_API_URL=/api
